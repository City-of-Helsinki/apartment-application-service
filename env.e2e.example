COMPOSE_PROJECT_NAME=att-e2e
DRUPAL_HOSTNAME=localhost
DRUPAL_IMAGE=ghcr.io/city-of-helsinki/drupal-web:8.3
APP_ENV=dev
DRUPAL_HASH_SALT=e2e-test-salt-not-for-production
ASU_REST_OAUTH_CLIENT_ID=installed_rest_client
ASU_REST_OAUTH_CLIENT_SECRET=example-token
DRUPAL_SERVER_AUTH_TOKEN=example-token

# Password for the throwaway E2E Postgres DB. Must be URL-safe (used in DATABASE_URL).
# Only applied when the DB volume is first created; run `docker compose -p att-e2e down -v`
# after changing it.
E2E_DJANGO_DB_PASSWORD=e2e-local-only

# Password of the "drupal" user built into the druidfi/mariadb:*-drupal image.
# Must match the image's default; it is not applied to the DB container.
E2E_DRUPAL_DB_PASSWORD=drupal

# Database encryption keypair
