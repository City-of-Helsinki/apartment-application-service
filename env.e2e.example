# Dump paths — set to the files you want seeded on first container start.
# DRUPAL_DUMP_PATH: SQL file mounted into MariaDB's init dir (only imported once, on empty DB).
# DJANGO_DUMP_PATH: JSON fixture loaded via loaddata on every django-app start.
#   Leave DJANGO_DUMP_PATH unset (or empty) to skip fixture loading.
DRUPAL_DUMP_PATH=../drupal-asuntotuotanto/dump-YYYY-MM-DD.sql
DJANGO_DUMP_PATH=../django-dump-XXXXXXXXXX.json
